# Lemma — Production / Supabase Environment Configuration
# Copy this to .env and fill in your database password

# =============================================================================
# DATABASE — Supabase Postgres Connection
# =============================================================================
# Get your connection string from:
#   https://supabase.com/dashboard/project/wnjvngrotuucsqaxbghv/settings/database
#
# Use the "Session mode" connection string (port 5432) for long-running backend:
# LEMMA_DATABASE_URL=postgresql://postgres.wnjvngrotuucsqaxbghv:[YOUR-DB-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
#
# Or use the "Transaction mode" connection string (port 6543) for serverless:
# LEMMA_DATABASE_URL=postgresql://postgres.wnjvngrotuucsqaxbghv:[YOUR-DB-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

LEMMA_DATABASE_URL=postgresql://postgres.wnjvngrotuucsqaxbghv:[YOUR-DB-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# =============================================================================
# ONLINE RETRIEVAL — Academic paper fetching
# =============================================================================
LEMMA_ENABLE_ONLINE_RETRIEVAL=true

# =============================================================================
# CELERY — Task execution mode
# =============================================================================
# Set to false + provide Redis URL for async workers in production
LEMMA_CELERY_ALWAYS_EAGER=true

# =============================================================================
# OLLAMA — LLM settings
# =============================================================================
# Unload model immediately after each request in production
LEMMA_OLLAMA_KEEP_ALIVE=0

# =============================================================================
# DEBUG — Disable in production
# =============================================================================
LEMMA_DEBUG_MODE=false
